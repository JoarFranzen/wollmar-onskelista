rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      // The public can view the wishlist.
      allow read: if true;

      // Guests may only reserve an unreserved wish. Admin writes go through the
      // Cloudflare Worker using a service account and therefore bypass these rules.
      allow create, delete: if false;
      allow update: if resource.data.reserved == false
        && request.resource.data.reserved == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reserved', 'reservedAt']);
    }
  }
}